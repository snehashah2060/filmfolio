# ========================================================
# FILMFOLIO ENVIRONMENT CONFIGURATION EXAMPLE
# ========================================================

# Supabase PostgreSQL & Auth Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key-here
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# TMDB (The Movie Database) API v3 Read Access Token
# Obtain from: https://www.themoviedb.org/settings/api
TMDB_ACCESS_TOKEN=your-tmdb-read-access-token-here
